# Seed Coding Plan's Anthropic-compatible endpoint. This is deliberately not
# shared or aliased with Seed Agent Plan.
CODING_PLAN_BASE_URL=https://ark.cn-beijing.volces.com/api/coding
CODING_PLAN_API_KEY=replace-with-your-coding-plan-key

CANARY_MODEL=kimi-k2.6
# Optional: leave unset to generate a unique nonce for each run.
# CANARY_NONCE=my-test-nonce
