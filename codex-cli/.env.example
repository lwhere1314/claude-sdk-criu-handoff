# An OpenAI-SDK-compatible endpoint that supports the Responses API. Codex 0.144+
# requires wire_api = "responses" (it dropped "chat"), which the controller sets.
OPENAI_BASE_URL=http://localhost:5000/v1
OPENAI_API_KEY=sk-local

# A model id served by the endpoint above.
CANARY_MODEL=gpt-5.5
# Optional: leave unset to generate a unique nonce for each run.
# CANARY_NONCE=my-test-nonce
