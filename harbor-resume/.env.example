# A model's Anthropic-independent, OpenAI-SDK-compatible endpoint used by the
# Codex agent Harbor runs. These are read by Harbor's Codex agent, not by this
# wrapper. See ../codex-cli/.env.example for the same variables.
OPENAI_BASE_URL=http://localhost:5000/v1
OPENAI_API_KEY=replace-with-your-openai-compatible-key

# Where snapshot metadata + CRIU dumps live (default ~/.harbor-resume).
# HARBOR_RESUME_HOME=/home/you/.harbor-resume
